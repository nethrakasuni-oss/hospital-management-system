generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  COMPLETED
  CANCELLED
}

enum PrescriptionVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LabRequestStatus {
  REQUESTED
  SAMPLE_PENDING
  SAMPLE_COLLECTED
  RECEIVED
  PROCESSING
  RESULT_ENTERED
  VERIFIED
  COMPLETED
  REJECTED
  CANCELLED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  EXPIRED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
  CANCELLED
}

enum MedicationAdministrationStatus {
  ADMINISTERED
  MISSED
  WITHHELD
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DoctorAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  EXTRA_HOURS
}

enum NotificationType {
  SYSTEM
  APPOINTMENT
  LAB_RESULT
  PRESCRIPTION
  BILLING
  ADMISSION
  LEAVE
  INVENTORY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum InvoiceVerificationStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabResultHistory {
  id Int @id @default(autoincrement())

  labResultId Int
  labResult   LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)

  resultValue     String?
  referenceRange  String?
  unit            String?
  abnormalFlag    String?
  critical        Boolean  @default(false)
  comments        String?
  amendmentReason String?
  changedById     Int
  changedBy       User     @relation(fields: [changedById], references: [id], onDelete: Restrict)
  changedAt       DateTime @default(now())

  @@index([labResultId, changedAt])
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus @default(ACTIVE)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  doctor   Doctor?
  employee Employee?

  // Doctor leave requests reviewed by this user (typically an administrator).
  doctorLeaveReviews          DoctorLeave[]               @relation("DoctorLeaveReviewer")
  employeeLeaveReviews        LeaveRecord[]               @relation("EmployeeLeaveReviewer")
  attendanceCorrectionReviews AttendanceCorrection[]      @relation("AttendanceCorrectionReviewer")
  verifiedLabResults          LabResult[]                 @relation("LabResultVerifier")
  labResultHistoryChanges     LabResultHistory[]
  dispensedPrescriptions      Prescription[]              @relation("PrescriptionDispenser")
  verifiedPrescriptions       Prescription[]              @relation("PrescriptionVerifier")
  reviewedInsuranceClaims     InsuranceClaim[]            @relation("InsuranceClaimReviewer")
  verifiedInvoices            Invoice[]                    @relation("InvoiceVerifier")
  rejectedInvoices            Invoice[]                    @relation("InvoiceRejector")
  nursingNotes                NursingNote[]               @relation("NursingNoteAuthor")
  medicationAdministrations   MedicationAdministration[]  @relation("MedicationAdministrationNurse")
  outgoingShiftHandovers      ShiftHandover[]             @relation("ShiftHandoverOutgoing")
  incomingShiftHandovers      ShiftHandover[]             @relation("ShiftHandoverIncoming")
  nursingDischargeClearances  NursingDischargeClearance[]
  notifications               Notification[]
  inventoryTransactions       InventoryTransaction[]      @relation("InventoryTransactionActor")
  createdPurchaseOrders       PurchaseOrder[]             @relation("PurchaseOrderCreator")

  auditLogs AuditLog[]
  uploadedPatientDocuments PatientDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEmergencyVisits     EmergencyVisit[]   @relation("EmergencyVisitCreator")
  requestedTransfers         PatientTransfer[]  @relation("TransferRequester")
  approvedTransfers          PatientTransfer[]  @relation("TransferApprover")
  preparedDischargeSummaries DischargeSummary[] @relation("DischargeSummaryAuthor")
  passwordResetTokens PasswordResetToken[]
}



model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model Department {
  id          Int     @id @default(autoincrement())
  code        String? @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Department head is an employee assigned to this department.
  headEmployeeId Int?      @unique
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  doctors   Doctor[]
  employees Employee[]
  wards     Ward[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Patient {
  id             Int       @id @default(autoincrement())
  patientNumber  String    @unique
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         Gender?
  phone          String?
  email          String?
  address        String?
  bloodGroup     String?
  emergencyName  String?
  emergencyPhone String?

  appointments               Appointment[]
  medicalRecords             MedicalRecord[]
  prescriptions              Prescription[]
  labRequests                LabRequest[]
  admissions                 Admission[]
  invoices                   Invoice[]
  insurancePolicies          PatientInsurance[]
  insuranceClaims            InsuranceClaim[]
  nursingAssignments         NursingAssignment[]
  nursingNotes               NursingNote[]
  nursingObservations        NursingObservation[]
  medicationAdministrations  MedicationAdministration[]
  shiftHandovers             ShiftHandover[]
  nursingDischargeClearances NursingDischargeClearance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyVisits    EmergencyVisit[]
  surgeryBookings    SurgeryBooking[]
  transfers          PatientTransfer[]
  dischargeSummaries DischargeSummary[]
  documents          PatientDocument[]
}

model PatientDocument {
  id            Int     @id @default(autoincrement())
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  documentType  String?
  storageKey    String  @unique

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  uploadedById Int?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

model Doctor {
  id             Int     @id @default(autoincrement())
  registrationNo String  @unique
  specialization String?
  qualification  String?

  // Professional profile
  biography       String?
  yearsExperience Int?
  profilePhotoUrl String?
  licenseExpiry   DateTime? @db.Date
  languages       String[]  @default([])

  // Default consultation fee
  consultationFee Decimal @default(0) @db.Decimal(12, 2)
  currency        String  @default("LKR")

  // Allows the hospital to deactivate a doctor without deleting their history.
  active Boolean @default(true)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Existing relationships
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labRequests    LabRequest[]

  // Doctor management relationships
  schedules    DoctorSchedule[]
  availability DoctorAvailability[]
  leaves       DoctorLeave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyVisits EmergencyVisit[]
  surgeryBookings SurgeryBooking[]

  @@index([departmentId])
  @@index([specialization])
  @@index([active])
}

model DoctorSchedule {
  id Int @id @default(autoincrement())

  // 0 = Sunday, 1 = Monday, ... 6 = Saturday.
  dayOfWeek Int

  // Store 24-hour time strings in HH:mm format (for example, 09:00).
  startTime String
  endTime   String

  slotDurationMinutes Int  @default(15)
  maxAppointments     Int?

  active Boolean @default(true)

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
}

model DoctorAvailability {
  id Int @id @default(autoincrement())

  // One date-specific override per doctor. Use for closures or extra sessions.
  date   DateTime                 @db.Date
  status DoctorAvailabilityStatus

  // Optional time range for EXTRA_HOURS or a limited AVAILABLE session.
  startTime String?
  endTime   String?
  reason    String?

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date])
  @@index([date, status])
}

model DoctorLeave {
  id Int @id @default(autoincrement())

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  reason    String
  leaveType String?
  status    LeaveStatus @default(PENDING)

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  reviewedById Int?
  reviewedBy   User? @relation("DoctorLeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt  DateTime?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, status])
  @@index([startDate, endDate])
}

model Appointment {
  id            Int    @id @default(autoincrement())
  appointmentNo String @unique

  scheduledAt DateTime
  duration    Int      @default(30)

  reason String?
  notes  String?

  consultationFee Decimal @default(0) @db.Decimal(10, 2)

  appointmentType AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(SCHEDULED)

  cancellationReason String?
  confirmedAt        DateTime?
  completedAt        DateTime?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  medicalRecord MedicalRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([departmentId])
  @@index([scheduledAt])
  @@index([status])
  @@index([doctorId, scheduledAt])
}

enum AppointmentType {
  IN_PERSON
  ONLINE
}

model MedicalRecord {
  id        Int     @id @default(autoincrement())
  diagnosis String?
  symptoms  String?
  treatment String?
  notes     String?

  appointmentId           Int?         @unique
  appointment             Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  chiefComplaint          String?
  historyPresentIllness   String?
  previousMedicalHistory  String?
  currentMedications      String?
  allergies               String?
  bloodPressure           String?
  pulse                   String?
  temperature             String?
  respiratoryRate         String?
  oxygenSaturation        String?
  weight                  String?
  height                  String?
  physicalExamination     String?
  followUpRecommendations String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  prescriptions Prescription[]
  labRequests   LabRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id                 Int                            @id @default(autoincrement())
  notes              String?
  status             PrescriptionStatus             @default(ACTIVE)
  verificationStatus PrescriptionVerificationStatus @default(PENDING)
  verificationReason String?
  verifiedAt         DateTime?
  verifiedById       Int?
  verifiedBy         User?                          @relation("PrescriptionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  medicalRecordId Int?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  dispensedAt   DateTime?
  dispensedById Int?
  dispensedBy   User?     @relation("PrescriptionDispenser", fields: [dispensedById], references: [id], onDelete: SetNull)

  items                     PrescriptionItem[]
  medicationAdministrations MedicationAdministration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrescriptionItem {
  id Int @id @default(autoincrement())

  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId Int?
  medicine   Medicine? @relation(fields: [medicineId], references: [id])

  medicineName      String
  dosage            String
  frequency         String
  duration          String?
  instructions      String?
  quantity          Int?
  dispensedQuantity Int     @default(0)

  createdAt DateTime @default(now())
}

model LabTest {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  name           String
  description    String?
  category       String?
  sampleType     String?
  referenceRange String?
  unit           String?
  price          Decimal @default(0) @db.Decimal(12, 2)
  active         Boolean @default(true)

  requestItems LabRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabRequest {
  id               Int              @id @default(autoincrement())
  status           LabRequestStatus @default(REQUESTED)
  notes            String?
  requestNumber    String           @unique @default("")
  sampleIdentifier String?
  barcode          String?
  collectedAt      DateTime?
  collectedById    Int?
  sampleRejected   Boolean          @default(false)
  rejectionReason  String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  medicalRecordId Int?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  items LabRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabRequestItem {
  id Int @id @default(autoincrement())

  labRequestId Int
  labRequest   LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)

  labTestId Int
  labTest   LabTest @relation(fields: [labTestId], references: [id])

  result LabResult?

  createdAt DateTime @default(now())

  @@unique([labRequestId, labTestId])
}

model LabResult {
  id              Int     @id @default(autoincrement())
  resultValue     String?
  referenceRange  String?
  unit            String?
  abnormalFlag    String?
  critical        Boolean @default(false)
  comments        String?
  amendmentReason String?
  remarks         String?

  labRequestItemId Int            @unique
  labRequestItem   LabRequestItem @relation(fields: [labRequestItemId], references: [id], onDelete: Cascade)

  verifiedAt   DateTime?
  verifiedById Int?
  verifiedBy   User?              @relation("LabResultVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  history      LabResultHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicineCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  medicines Medicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  genericName  String?
  manufacturer String?
  unit         String
  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  active       Boolean @default(true)

  categoryId Int?
  category   MedicineCategory? @relation(fields: [categoryId], references: [id])

  batches               MedicineBatch[]
  inventoryTransactions InventoryTransaction[]
  prescriptionItems     PrescriptionItem[]
  purchaseOrderItems    PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicineBatch {
  id          Int       @id @default(autoincrement())
  batchNumber String
  quantity    Int
  costPrice   Decimal   @db.Decimal(12, 2)
  expiryDate  DateTime?

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems    PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, batchNumber])
}

model InventoryTransaction {
  id          Int                      @id @default(autoincrement())
  type        InventoryTransactionType
  quantity    Int
  notes       String?
  referenceNo String?

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  batchId Int?
  batch   MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  performedById Int?
  performedBy   User? @relation("InventoryTransactionActor", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([medicineId, createdAt])
  @@index([type, createdAt])
}

model Ward {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingTransfers PatientTransfer[] @relation("TransferFromWard")
  incomingTransfers PatientTransfer[] @relation("TransferToWard")
}

model Room {
  id         Int    @id @default(autoincrement())
  roomNumber String
  dailyRate  Decimal? @db.Decimal(12, 2)

  wardId Int
  ward   Ward @relation(fields: [wardId], references: [id])

  beds Bed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wardId, roomNumber])
}

model Bed {
  id        Int       @id @default(autoincrement())
  bedNumber String
  status    BedStatus @default(AVAILABLE)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingTransfers PatientTransfer[] @relation("TransferFromBed")
  incomingTransfers PatientTransfer[] @relation("TransferToBed")

  @@unique([roomId, bedNumber])
}

model Admission {
  id            Int             @id @default(autoincrement())
  admissionDate DateTime        @default(now())
  dischargeDate DateTime?
  reason        String?
  status        AdmissionStatus @default(ADMITTED)

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  bedId Int?
  bed   Bed? @relation(fields: [bedId], references: [id])

  nursingAssignments NursingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyVisits  EmergencyVisit[]
  surgeryBookings  SurgeryBooking[]
  transfers        PatientTransfer[]
  dischargeSummary DischargeSummary?
}

model Employee {
  id          Int       @id @default(autoincrement())
  employeeNo  String    @unique
  designation String
  joinedDate  DateTime?
  isActive    Boolean   @default(true)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Optional department for which this employee is the designated head.
  headsDepartment Department? @relation("DepartmentHead")

  attendanceRecords         Attendance[]
  leaveRecords              LeaveRecord[]
  Corrections               AttendanceCorrection[]
  nursingAssignments        NursingAssignment[]
  nursingNotes              NursingNote[]
  nursingObservations       NursingObservation[]
  medicationAdministrations MedicationAdministration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id Int @id @default(autoincrement())

  date DateTime @db.Date

  checkIn  DateTime?
  checkOut DateTime?

  status AttendanceStatus @default(PRESENT)

  breakDurationMinutes Int @default(0)
  workingMinutes       Int @default(0)

  lateMinutes           Int @default(0)
  earlyDepartureMinutes Int @default(0)

  notes String?

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  corrections AttendanceCorrection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrection {
  id Int @id @default(autoincrement())

  requestedDate DateTime @db.Date

  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?

  reason String

  status AttendanceCorrectionStatus @default(PENDING)

  reviewNotes  String?
  reviewedById Int?
  reviewedBy   User?     @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendanceId Int?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([requestedDate])
}

model LeaveRecord {
  id        Int         @id @default(autoincrement())
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  leaveType String?
  reason    String?
  status    LeaveStatus @default(PENDING)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("EmployeeLeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  verificationStatus InvoiceVerificationStatus @default(DRAFT)
  submittedAt DateTime?
  verifiedAt DateTime?
  verifiedById Int?
  verifiedBy User? @relation("InvoiceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedAt DateTime?
  rejectedById Int?
  rejectedBy User? @relation("InvoiceRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  dueDate       DateTime?     @db.Date
  notes         String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sourceType  String?
  sourceId    Int?

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sourceType, sourceId])
}

model Payment {
  id             Int     @id @default(autoincrement())
  amount         Decimal @db.Decimal(12, 2)
  method         String
  reference      String?
  status         String  @default("COMPLETED")
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  notes          String?

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, createdAt])
}

model AuditLog {
  id        Int     @id @default(autoincrement())
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

/// Nursing care assignment connecting a nurse employee to a patient/admission.
model NursingAssignment {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  admissionId Int?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  shift      String?
  notes      String?
  active     Boolean   @default(true)

  nursingNotes NursingNote[]
  observations NursingObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, active])
  @@index([patientId, active])
  @@index([admissionId])
}

/// Clinical nursing notes; author can be an employee and/or authenticated user.
model NursingNote {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  authorUserId Int?
  authorUser   User? @relation("NursingNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  assignmentId Int?
  assignment   NursingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  noteType   String   @default("GENERAL")
  content    String
  recordedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, recordedAt])
}

/// Structured observations/vital signs recorded during nursing care.
model NursingObservation {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  assignmentId Int?
  assignment   NursingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  observedAt       DateTime @default(now())
  temperatureC     Decimal? @db.Decimal(5, 2)
  systolicBP       Int?
  diastolicBP      Int?
  pulseBpm         Int?
  respiratoryRate  Int?
  oxygenSaturation Decimal? @db.Decimal(5, 2)
  bloodGlucose     Decimal? @db.Decimal(7, 2)
  weightKg         Decimal? @db.Decimal(7, 2)
  heightCm         Decimal? @db.Decimal(7, 2)
  painScore        Int?
  notes            String?

  createdAt DateTime @default(now())

  @@index([patientId, observedAt])
}

model MedicationAdministration {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  nurseUserId Int
  nurseUser   User @relation("MedicationAdministrationNurse", fields: [nurseUserId], references: [id], onDelete: Restrict)

  nurseEmployeeId Int?
  nurseEmployee   Employee? @relation(fields: [nurseEmployeeId], references: [id], onDelete: SetNull)

  status         MedicationAdministrationStatus
  administeredAt DateTime
  reason         String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, administeredAt])
  @@index([prescriptionId, administeredAt])
}

model ShiftHandover {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  admissionId         Int?
  outgoingNurseUserId Int
  outgoingNurseUser   User @relation("ShiftHandoverOutgoing", fields: [outgoingNurseUserId], references: [id], onDelete: Restrict)

  incomingNurseUserId Int
  incomingNurseUser   User @relation("ShiftHandoverIncoming", fields: [incomingNurseUserId], references: [id], onDelete: Restrict)

  patientSummary        String
  currentCondition      String
  pendingMedications    String?
  pendingInvestigations String?
  importantObservations String?
  escalationNotes       String?

  handedOverAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId, handedOverAt])
  @@index([admissionId, handedOverAt])
}

model NursingDischargeClearance {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  admissionId Int  @unique
  nurseUserId Int
  nurseUser   User @relation(fields: [nurseUserId], references: [id], onDelete: Restrict)

  nursingDischargeNotes String?
  patientEducation      String?
  nursingClearance      Boolean   @default(false)
  documentationComplete Boolean   @default(false)
  clearedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
}

/// Insurance organization/provider.
model InsuranceProvider {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  code          String? @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean @default(true)

  policies PatientInsurance[]
  claims   InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Insurance policy/coverage held by a patient.
model PatientInsurance {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  providerId Int
  provider   InsuranceProvider @relation(fields: [providerId], references: [id])

  policyNumber  String
  memberNumber  String?
  coverageStart DateTime? @db.Date
  coverageEnd   DateTime? @db.Date
  coverageLimit Decimal?  @db.Decimal(12, 2)
  isPrimary     Boolean   @default(false)
  isActive      Boolean   @default(true)
  notes         String?

  claims InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, policyNumber])
  @@index([patientId, isActive])
}

/// Claim submitted against an insurance policy and optionally an invoice.
model InsuranceClaim {
  id             Int                  @id @default(autoincrement())
  claimNumber    String               @unique
  status         InsuranceClaimStatus @default(DRAFT)
  claimedAmount  Decimal              @db.Decimal(12, 2)
  approvedAmount Decimal?             @db.Decimal(12, 2)
  paidAmount     Decimal              @default(0) @db.Decimal(12, 2)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewNotes    String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  providerId Int
  provider   InsuranceProvider @relation(fields: [providerId], references: [id])

  patientInsuranceId Int?
  patientInsurance   PatientInsurance? @relation(fields: [patientInsuranceId], references: [id], onDelete: SetNull)

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  reviewedById Int?
  reviewedBy   User? @relation("InsuranceClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@index([providerId, status])
}

/// User-facing notification record; delivery integrations can be added separately.
model Notification {
  id            Int                 @id @default(autoincrement())
  title         String
  message       String
  type          NotificationType    @default(SYSTEM)
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  readAt        DateTime?
  sentAt        DateTime?
  failureReason String?
  metadata      Json?

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientEmail String?
  recipientPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([channel, status])
}

/// Hospital-wide key/value configuration; restrict writes to administrators.
model SystemSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       Json
  description String?
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Supplier/vendor for pharmacy procurement.
model Supplier {
  id            Int     @id @default(autoincrement())
  name          String
  code          String? @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean @default(true)

  medicineBatches MedicineBatch[]
  purchaseOrders  PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Purchase order header.
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  orderNumber String              @unique
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime            @default(now())
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  totalAmount Decimal             @default(0) @db.Decimal(12, 2)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdById Int?
  createdBy   User? @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
}

/// Purchase order line; optional batch link populated on receipt.
model PurchaseOrderItem {
  id               Int     @id @default(autoincrement())
  description      String?
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  receivedBatchId Int?
  receivedBatch   MedicineBatch? @relation(fields: [receivedBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicineId])
}

enum EmergencyTriageLevel {
  RESUSCITATION
  EMERGENCY
  URGENT
  LESS_URGENT
  NON_URGENT
}

enum EmergencyVisitStatus {
  REGISTERED
  TRIAGED
  UNDER_TREATMENT
  OBSERVATION
  ADMITTED
  DISCHARGED
  TRANSFERRED
  LEFT_WITHOUT_BEING_SEEN
  CANCELLED
}

enum TheatreStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNAVAILABLE
}

enum SurgeryStatus {
  SCHEDULED
  PREPARATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum PatientTransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

model EmergencyVisit {
  id             Int                  @id @default(autoincrement())
  visitNumber    String               @unique
  arrivalAt      DateTime             @default(now())
  triageLevel    EmergencyTriageLevel
  status         EmergencyVisitStatus @default(REGISTERED)
  chiefComplaint String
  clinicalNotes  String?
  vitalSigns     Json?
  disposition    String?
  dischargedAt   DateTime?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  admissionId Int?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  attendingDoctorId Int?
  attendingDoctor   Doctor? @relation(fields: [attendingDoctorId], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User? @relation("EmergencyVisitCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([arrivalAt, status])
  @@index([patientId, arrivalAt])
  @@index([triageLevel, status])
}

model OperationTheatre {
  id          Int           @id @default(autoincrement())
  theatreCode String        @unique
  name        String
  location    String?
  status      TheatreStatus @default(AVAILABLE)
  isActive    Boolean       @default(true)

  surgeryBookings SurgeryBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isActive])
}

model SurgeryBooking {
  id                 Int           @id @default(autoincrement())
  bookingNumber      String        @unique
  procedureName      String
  plannedStartAt     DateTime
  plannedEndAt       DateTime
  actualStartAt      DateTime?
  actualEndAt        DateTime?
  status             SurgeryStatus @default(SCHEDULED)
  preOpNotes         String?
  postOpNotes        String?
  cancellationReason String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  admissionId Int?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  theatreId Int
  theatre   OperationTheatre @relation(fields: [theatreId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plannedStartAt, status])
  @@index([patientId, plannedStartAt])
  @@index([doctorId, plannedStartAt])
  @@index([theatreId, plannedStartAt])
}

model PatientTransfer {
  id             Int                   @id @default(autoincrement())
  transferNumber String                @unique
  reason         String
  status         PatientTransferStatus @default(REQUESTED)
  requestedAt    DateTime              @default(now())
  approvedAt     DateTime?
  completedAt    DateTime?
  notes          String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  admissionId Int?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  fromWardId Int?
  fromWard   Ward? @relation("TransferFromWard", fields: [fromWardId], references: [id], onDelete: SetNull)

  toWardId Int
  toWard   Ward @relation("TransferToWard", fields: [toWardId], references: [id], onDelete: Restrict)

  fromBedId Int?
  fromBed   Bed? @relation("TransferFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)

  toBedId Int?
  toBed   Bed? @relation("TransferToBed", fields: [toBedId], references: [id], onDelete: SetNull)

  requestedById Int?
  requestedBy   User? @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  approvedById Int?
  approvedBy   User? @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@index([toWardId, status])
  @@index([requestedAt, status])
}

model DischargeSummary {
  id                   Int      @id @default(autoincrement())
  summaryNumber        String   @unique
  admissionDate        DateTime
  dischargeDate        DateTime
  principalDiagnosis   String
  secondaryDiagnoses   String?
  proceduresPerformed  String?
  treatmentSummary     String
  dischargeMedication  String?
  followUpInstructions String?
  conditionAtDischarge String?
  preparedAt           DateTime @default(now())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  admissionId Int       @unique
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  preparedById Int?
  preparedBy   User? @relation("DischargeSummaryAuthor", fields: [preparedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, dischargeDate])
}
